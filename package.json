{
  "name": "@peter.naydenov/stack",
  "description": "Build stacks. FIFO and LIFO.",
  "version": "3.0.1",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/stack.umd.js",
  "type": "module",
  "types": "./dist/stack.d.ts",
  "exports": {
    ".": {
      "types": "./dist/stack.d.ts",
      "import": "./dist/stack.esm.mjs",
      "require": "./dist/stack.cjs",
      "default": "./dist/stack.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "mocha test",
    "cover": "c8 mocha test",
    "build:types": "tsc --project tsconfig.json && node -e \"require('fs').renameSync('dist/index.d.ts', 'dist/stack.d.ts')\"",
    "build": "npm run build:types && rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/stack.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "c8": "^11.0.0",
    "chai": "6.2.2",
    "mocha": "11.7.6",
    "rollup": "^4.61.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "keywords": [
    "fifo",
    "lifo",
    "stack"
  ],
  "homepage": "https://github.com/PeterNaydenov/stack#readme",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/stack/issues"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
